{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: folder lists, the conversation view, message actions and attachment saving, opening and revealing. Every app command is granted by name (build.rs declares them, so anything missing here is refused); core and plugin permissions are only the ones the window uses — event listening, the toolbar's drag region, and the save/open dialogs for attachments.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "dialog:allow-save",
    "dialog:allow-open",
    "allow-archive-message",
    "allow-archive-messages",
    "allow-archive-thread",
    "allow-cached-summary",
    "allow-cancel-scheduled",
    "allow-cancel-summary",
    "allow-discard-draft",
    "allow-get-date-time-format",
    "allow-get-message-body",
    "allow-get-message-quote",
    "allow-get-shortcuts",
    "allow-get-swipe-actions",
    "allow-get-thread-order",
    "allow-list-accounts",
    "allow-list-aliases",
    "allow-list-mailboxes",
    "allow-list-messages",
    "allow-list-scheduled",
    "allow-list-thread",
    "allow-llm-status",
    "allow-load-domain-avatars",
    "allow-log-timing",
    "allow-move-message",
    "allow-move-messages",
    "allow-move-thread",
    "allow-move-to-trash",
    "allow-open-attachment",
    "allow-open-compose",
    "allow-open-draft",
    "allow-open-settings",
    "allow-refresh-account",
    "allow-reveal-attachment",
    "allow-save-all-attachments",
    "allow-save-attachment",
    "allow-search-messages",
    "allow-send-scheduled-now",
    "allow-set-message-read",
    "allow-set-messages-read",
    "allow-summarize-message",
    "allow-summarize-thread",
    "allow-sync-account",
    "allow-thread-bodies",
    "allow-timing-enabled",
    "allow-trash-messages",
    "allow-trash-thread",
    "allow-translate-message",
    "allow-undo-send",
    "allow-view-status"
  ]
}
