{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: accounts, aliases, signatures, notifications, appearance, shortcuts and the experimental models. It never sends mail or writes files; its only dialog is the account-deletion confirmation.",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-ask",
    "allow-add-account",
    "allow-add-oauth-account",
    "allow-cancel-oauth-sign-in",
    "allow-add-alias",
    "allow-cancel-llm-download",
    "allow-close-settings",
    "allow-create-signature",
    "allow-delete-account",
    "allow-delete-alias",
    "allow-delete-signature",
    "allow-download-llm-model",
    "allow-get-appearance",
    "allow-get-avatar-lookup-enabled",
    "allow-get-date-time-format",
    "allow-get-llm-summary-enabled",
    "allow-get-llm-summary-language",
    "allow-get-llm-translate-enabled",
    "allow-get-llm-translate-language",
    "allow-get-notification-settings",
    "allow-get-remote-image-policy",
    "allow-get-shortcuts",
    "allow-get-swipe-actions",
    "allow-get-thread-order",
    "allow-list-accounts",
    "allow-list-aliases",
    "allow-list-signatures",
    "allow-llm-status",
    "allow-log-timing",
    "allow-oauth-providers",
    "allow-preview-notification-sound",
    "allow-reconnect-account",
    "allow-remove-llm-model",
    "allow-reset-shortcuts",
    "allow-set-account-color",
    "allow-set-account-notifications",
    "allow-set-appearance",
    "allow-set-avatar-lookup-enabled",
    "allow-set-date-time-format",
    "allow-set-default-alias",
    "allow-set-llm-model",
    "allow-set-llm-summary-enabled",
    "allow-set-llm-summary-language",
    "allow-set-llm-translate-enabled",
    "allow-set-llm-translate-language",
    "allow-set-notification-settings",
    "allow-set-remote-image-policy",
    "allow-set-shortcut",
    "allow-set-signature-accounts",
    "allow-set-swipe-actions",
    "allow-set-thread-order",
    "allow-test-connection",
    "allow-timing-enabled",
    "allow-update-alias",
    "allow-update-signature"
  ]
}
